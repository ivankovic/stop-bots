# Generated by stop-bots {VERSION}, with `stop-bots install web`.
# stop-bots-template: {SHA256}
#
# Re-running that command replaces this file for as long as it is
# unedited: the stop-bots-template line is a hash of everything else
# here, and is how it tells. An edited copy is left alone, and the
# installer says so; `--force` replaces it anyway.
#
# Settings deliberately absent from ExecStart: the bind address, the host
# allowlist, the path prefix and whether exposure is permitted live in the
# `settings` table, because the running server re-reads them. Adding a flag
# for one here gives it two sources of truth and the database wins on the
# next restart. Change them with `stop-bots set-web ...`.
[Unit]
Description=stop-bots web console
Documentation=https://github.com/ivankovic/stop-bots
# Wants rather than Requires for NGINX: the console is most worth looking
# at when NGINX is down, so it must not be stopped along with it. Requires
# for the helper's socket: without it the console can show, not apply.
After=network-online.target nginx.service stop-bots-helper.socket
Wants=network-online.target
Requires=stop-bots-helper.socket

[Service]
Type=exec
ExecStart=/usr/local/bin/stop-bots web --db /var/lib/stop-bots/db.sqlite3 --helper /run/stop-bots/helper.sock
Restart=on-failure
RestartSec=5s

# Not root. Everything that needs root -- writing the NGINX config and
# the firewall script, `nginx -t`, the reload, nft -- the console asks of
# stop-bots-helper.service over the socket above, which takes a fixed set of
# operations and no paths, commands or config text. Code running as this
# service runs as stop-bots, not as root.
User=stop-bots
Group=stop-bots
# No log groups: the helper reads the two logs the detectors need and
# returns only those lines, of the SSH log only sshd's. The rest of
# /var/log and the journal is hidden, the world-readable parts too.
InaccessiblePaths=-/var/log -/run/log

# It writes its database and nothing else, holds no capability and can
# gain none, cannot reach netlink to change the firewall, and cannot see
# the sockets it would ask systemd anything over -- polkit refuses an
# unprivileged caller anyway; hiding them is defence in depth.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=-/var/lib/stop-bots
ProtectHome=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
# AF_UNIX for the helper's socket, AF_INET/AF_INET6 for the console itself
# and the list downloads.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/run/dbus/system_bus_socket -/run/systemd/private
# The database holds the console's password hash.
UMask=0077

# stop-bots is here to protect the sites on this host, so it must never be
# what starves them: a detector pass or a firewall render on a busy host
# holds tens of megabytes, on a machine that may have 1 GB in all. Lower
# CPU and I/O priority than NGINX, so that work waits for a quiet moment
# rather than competing.
Nice=10
IOSchedulingClass=idle
# MemoryHigh throttles and reclaims; it never kills. Past it the service
# slows down, which background work can afford. MemoryMax is only the
# backstop for a runaway: at that point the kernel stops this service
# rather than choosing a victim host-wide. Percentages are of physical
# RAM: 256 MB and 512 MB on a 1 GB VPS, and more on a machine that has it.
MemoryHigh=25%
MemoryMax=50%
# A descriptor per connection: the default soft limit of 1024 ran out at
# about 1,100 held connections. TasksMax bounds threads and child
# processes together, well above the 512 blocking threads tokio may use.
LimitNOFILE=16384
TasksMax=1024

[Install]
WantedBy=multi-user.target
