# Generated by stop-bots {VERSION}, with `stop-bots install web`.
# stop-bots-template: {SHA256}
#
# Re-running that command replaces this file for as long as it is
# unedited: the stop-bots-template line is a hash of everything else
# here, and is how it tells. An edited copy is left alone, and the
# installer says so; `--force` replaces it anyway.
[Unit]
Description=stop-bots root helper
Documentation=https://github.com/ivankovic/stop-bots
Requires=stop-bots-helper.socket
After=stop-bots-helper.socket

[Service]
Type=exec
ExecStart=/usr/local/bin/stop-bots helper --db /var/lib/stop-bots/db.sqlite3

# Root, and has to be: it rewrites this host's NGINX config, writes the
# firewall script, and runs `nginx -t`, the reload and nft. It takes
# requests only from root and the console's user, and only a fixed set
# of operations, none of which carries a path, a command or config
# text. ProtectSystem=strict and ReadWritePaths= keep it to the files
# it writes: the database, /etc/stop-bots, the NGINX config, the NGINX
# logs (`nginx -t` opens them for writing), and /run (`nginx -t`
# creates /run/nginx.pid, which NGINX replaces whenever it restarts, so
# granting that one file stops working after the next restart). Cron,
# the systemd units and every binary stay out of reach. `-`: a missing
# path is skipped, rather than keeping the helper from starting.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=-/var/lib/stop-bots
ReadWritePaths=-/etc/stop-bots
ReadWritePaths=-/etc/nginx
ReadWritePaths=-/var/log/nginx
ReadWritePaths=-/run
ProtectHome=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# CAP_NET_ADMIN and CAP_NET_RAW to load the firewall. CAP_DAC_OVERRIDE
# because the logs it reads and `nginx -t` opens belong to www-data and
# adm, and the database to the console's user. CAP_CHOWN and CAP_FOWNER
# because a site file keeps its owner and mode when it is rewritten, and
# because SQLite gives a -wal it creates to the database's owner. Nothing
# else, and above all not CAP_SYS_ADMIN, with which root can remount what
# ProtectSystem made read-only.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
# AF_UNIX for the console's requests, the D-Bus socket `systemctl reload
# nginx` talks over and a Docker socket for `docker exec`; AF_NETLINK
# because both `nft` and Debian's nft-backed `iptables` reach the kernel
# over netlink. AF_INET and AF_INET6 not for downloads -- it makes none --
# but for `nginx -t`, which opens a socket for every `listen` and fails
# without them.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

# stop-bots is here to protect the sites on this host, so it must never be
# what starves them: a detector pass or a firewall render on a busy host
# holds tens of megabytes, on a machine that may have 1 GB in all. Lower
# CPU and I/O priority than NGINX, so that work waits for a quiet moment
# rather than competing.
Nice=10
IOSchedulingClass=idle
# MemoryHigh throttles and reclaims; it never kills. Past it the service
# slows down, which background work can afford. MemoryMax is only the
# backstop for a runaway: at that point the kernel stops this service
# rather than choosing a victim host-wide. Percentages are of physical
# RAM: 256 MB and 512 MB on a 1 GB VPS, and more on a machine that has it.
MemoryHigh=25%
MemoryMax=50%
# A descriptor per connection: the default soft limit of 1024 ran out at
# about 1,100 held connections. TasksMax bounds threads and child
# processes together, well above the 512 blocking threads tokio may use.
LimitNOFILE=16384
TasksMax=1024
# Also absent on purpose: SystemCallFilter=, because the NGINX commands
# this runs are the operator's (`docker exec ...`) and untested under a
# filter.
