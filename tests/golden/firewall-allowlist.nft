#!/usr/sbin/nft -f
# Generated by stop-bots. Not executed automatically — review, then run
# with: nft -f <this file>
#
# Only touches our own "inet stop_bots" table (no `flush ruleset`) and
# uses "policy accept" so this chain can't become an implicit
# default-deny for all inbound traffic.

add table inet stop_bots
delete table inet stop_bots
add table inet stop_bots
add chain inet stop_bots bot_block { type filter hook input priority -1; policy accept; }

add rule inet stop_bots bot_block ct state established,related accept
add rule inet stop_bots bot_block iif lo accept

add rule inet stop_bots bot_block ip saddr 203.0.113.0/24 accept
add rule inet stop_bots bot_block ip saddr 0.0.0.0/0 drop
add rule inet stop_bots bot_block ip6 saddr ::/0 drop
