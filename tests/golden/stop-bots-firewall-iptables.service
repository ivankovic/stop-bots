# Generated by stop-bots {VERSION}, with `stop-bots install firewall`.
# stop-bots-template: {SHA256}
#
# Re-running that command replaces this file for as long as it is
# unedited: the stop-bots-template line is a hash of everything else
# here, and is how it tells. An edited copy is left alone, and the
# installer says so; `--force` replaces it anyway.
#
# Deliberately NOT nftables.service: that unit loads /etc/nftables.conf,
# which is not this file, so it would restore a different ruleset entirely
# -- and on a stock Debian or Ubuntu it would also `flush ruleset` at boot,
# dropping whatever else manages tables on this host.
[Unit]
Description=Apply the stop-bots firewall ruleset
Documentation=https://github.com/ivankovic/stop-bots
After=docker.service ufw.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/stop-bots/firewall.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /etc/stop-bots/firewall.sh

# The script runs as root at every boot and the console writes it, so
# this may load rules and do nothing else: every path read-only, only
# the capabilities loading rules takes, and no AF_UNIX, which is how
# root would ask systemd to run something outside this sandbox.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_NETLINK AF_INET AF_INET6
# iptables-legacy refuses to run without its lock file and cannot
# create one in a read-only /run, but only reads one that is there;
# `+` creates it outside the sandbox. It also runs modprobe itself
# when ip_tables is not loaded yet.
ExecStartPre=+/usr/bin/touch /run/xtables.lock
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_MODULE

[Install]
WantedBy=multi-user.target
