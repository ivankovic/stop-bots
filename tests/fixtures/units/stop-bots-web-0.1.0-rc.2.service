# Generated by stop-bots 0.1.0-rc.2, with `stop-bots install web`.
# stop-bots-template: 2c09031487f6b4f2e8ce507766944956f4c0d2c563e364f6051ad3de001f7447
#
# Re-running that command replaces this file for as long as it is
# unedited: the stop-bots-template line is a hash of everything else
# here, and is how it tells. An edited copy is left alone, and the
# installer says so; `--force` replaces it anyway.
#
# Settings deliberately absent from ExecStart: the bind address, the host
# allowlist, the path prefix, whether exposure is permitted, and the NGINX
# config root all live in the `settings` table, because the running server
# re-reads them. Adding a flag for one here gives it two sources of truth
# and the database wins on the next restart. Change them with
# `stop-bots set-web ...` and `stop-bots set-nginx-commands --root ...`.
[Unit]
Description=stop-bots web console
Documentation=https://github.com/ivankovic/stop-bots
# Wants rather than Requires: the console is most worth looking at when
# NGINX is down, so it must not be stopped along with it.
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/stop-bots web --db /var/lib/stop-bots/db.sqlite3
Restart=on-failure
RestartSec=5s

# Runs as root, and has to: it rewrites this host's NGINX config, writes
# the firewall script, and runs `nginx -t` and `systemctl reload nginx`.
# The directives below keep that root to those files. ProtectSystem=strict
# makes everything read-only, and ReadWritePaths= gives back what the
# console writes: its database, /etc/stop-bots, the NGINX config, the
# NGINX logs (`nginx -t` opens them for writing), and /run (`nginx -t`
# creates /run/nginx.pid, which NGINX replaces whenever it restarts, so
# granting that one file stops working after the next restart). Cron,
# the systemd units and every binary stay out of reach. `-`: a missing
# path is skipped, rather than keeping the console from starting.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=-/var/lib/stop-bots
ReadWritePaths=-/etc/stop-bots
ReadWritePaths=-/etc/nginx
ReadWritePaths=-/var/log/nginx
ReadWritePaths=-/run
ProtectHome=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# CAP_NET_ADMIN and CAP_NET_RAW to load the firewall. CAP_DAC_OVERRIDE
# because the logs it reads and `nginx -t` opens belong to www-data and
# adm, not root. CAP_CHOWN and CAP_FOWNER because a site file keeps its
# owner and mode when it is rewritten. CAP_NET_BIND_SERVICE for a console
# bound below port 1024. Nothing else, and above all not CAP_SYS_ADMIN,
# with which root can remount what ProtectSystem made read-only.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_NET_BIND_SERVICE
# AF_UNIX for the dbus socket `systemctl reload nginx` talks over,
# AF_INET/AF_INET6 for the console itself and the list downloads,
# and AF_NETLINK because the console applies the firewall script:
# both `nft` and Debian's nft-backed `iptables` talk to the kernel
# over netlink. Without it the apply fails with
# "Unable to initialize Netlink socket: Address family not
# supported by protocol", which names neither this file nor the
# reason. This line said the opposite until applying arrived; a
# comment asserting what a service does not need is a comment that
# goes stale the moment it starts needing it.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# The database holds the console's password hash.
UMask=0077

# The console is here to protect the sites on this host, so it must
# never be what starves them. A detector pass reads the whole access
# log, which on a busy host is tens of megabytes held twice over, on a
# machine that may have 1 GB in all. Lower CPU and I/O priority than
# NGINX, so a pass waits for a quiet moment rather than competing.
Nice=10
IOSchedulingClass=idle
# MemoryHigh throttles and reclaims; it never kills. Past it the
# console slows down, which a background pass can afford. MemoryMax
# is only the backstop for a runaway: at that point the kernel stops
# this service rather than choosing a victim host-wide, and
# Restart=on-failure brings it back. Percentages are of physical RAM:
# 256 MB and 512 MB on a 1 GB VPS, and more on a machine that has it.
MemoryHigh=25%
MemoryMax=50%
# A descriptor per connection: the default soft limit of 1024 ran out
# at about 1,100 held connections. TasksMax bounds threads and child
# processes together, well above the 512 blocking threads tokio may use.
LimitNOFILE=16384
TasksMax=1024

# What this does not stop: root that can reach systemd over D-Bus, as
# `systemctl reload nginx` must, can have systemd run anything outside
# this sandbox, and NGINX runs as root on the config written here. It
# turns a stray or tricked write into nothing; it is not a boundary
# against code running as this service. Also absent on purpose: User=,
# see above, and SystemCallFilter=, because the NGINX commands this runs
# are the operator's (`docker exec ...`) and untested under a filter.

[Install]
WantedBy=multi-user.target
