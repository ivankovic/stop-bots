# Generated by stop-bots 0.1.0-rc.1, with `stop-bots install firewall`.
# stop-bots-template: 8d72e4ff6a3c306c0b24cfdac6fbf8f3782d949a447ceb0b82f491f451f82f55
#
# Re-running that command replaces this file for as long as it is
# unedited: the stop-bots-template line is a hash of everything else
# here, and is how it tells. An edited copy is left alone, and the
# installer says so; `--force` replaces it anyway.
#
# Deliberately NOT nftables.service: that unit loads /etc/nftables.conf,
# which is not this file, so it would restore a different ruleset entirely
# -- and on a stock Debian or Ubuntu it would also `flush ruleset` at boot,
# dropping whatever else manages tables on this host.
[Unit]
Description=Apply the stop-bots firewall ruleset
Documentation=https://github.com/ivankovic/stop-bots
After=docker.service ufw.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/stop-bots/firewall.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /etc/stop-bots/firewall.sh

[Install]
WantedBy=multi-user.target
