# Maintainer: Marko Ivankovic <marko@ivankovic.me>
pkgname=stop-bots
pkgver=0.11.1
pkgrel=1
pkgdesc="A TUI and CLI that help you configure NGINX, Apache or Traefik and your firewall to stop bad bots and still allow good bots"
arch=('x86_64')
url="https://github.com/ivankovic/stop-bots"
license=('AGPL-3.0-only')
depends=('gcc-libs')
makedepends=('cargo')
# makepkg's default `lto` adds -flto to CFLAGS, so the C that rusqlite and
# aws-lc-sys bundle is compiled to GCC LTO bitcode — which rustc's linker
# (lld, since Rust 1.90) cannot read, and the build fails on undefined
# sqlite3_* symbols. Rust's own LTO is Cargo.toml's business, not this.
options=('!lto')
# Not depends: the tool shells out to these only when you ask it to, and a
# server running nftables should not be made to install iptables to try it.
optdepends=('nginx: to apply the generated site blocking rules'
            'apache: to apply the generated site blocking rules, instead of nginx'
            'traefik: to apply the generated blocking routers, instead of nginx'
            'nftables: to apply the generated firewall script'
            'iptables: alternative firewall backend')
# From crates.io rather than from a GitHub tag: it is the artefact `cargo
# publish` produced, so what is built here is byte-for-byte what
# `cargo install stop-bots` builds.
source=("$pkgname-$pkgver.tar.gz::https://static.crates.io/crates/$pkgname/$pkgname-$pkgver.crate")
# Written by packaging/bump.py: the checksum crates.io recorded at publish.
sha256sums=('5c98bf29e47c3fbde25b6c9f24bce348f8eb49a558b566cae128d4e65e428c41')

prepare() {
  cd "$pkgname-$pkgver"
  # Vendors the exact tree Cargo.lock pins, so the build is offline and
  # reproducible — which is what `--frozen` below then enforces.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
  # The hidden `generate-docs` verb writes what the release workflow puts
  # in the .deb: a man page per verb and the shell completions.
  "target/release/$pkgname" generate-docs --out target/assets
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # The container suite is not run here: it needs Docker and NET_ADMIN,
  # which a package build has neither of and should not ask for.
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm0755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # The man pages and completions the .deb ships, from the binary's own
  # clap definition. Arch's zsh and bash-completion look in these paths;
  # makepkg compresses the man pages itself.
  install -Dm0644 -t "$pkgdir/usr/share/man/man1/" target/assets/man/*.1
  install -Dm0644 target/assets/completions/stop-bots.bash "$pkgdir/usr/share/bash-completion/completions/stop-bots"
  install -Dm0644 target/assets/completions/_stop-bots "$pkgdir/usr/share/zsh/site-functions/_stop-bots"
  install -Dm0644 target/assets/completions/stop-bots.fish "$pkgdir/usr/share/fish/vendor_completions.d/stop-bots.fish"
}
