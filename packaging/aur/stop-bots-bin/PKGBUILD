# Maintainer: Marko Ivankovic <marko@ivankovic.me>
pkgname=stop-bots-bin
_pkgname=stop-bots
pkgver=0.11.1
pkgrel=1
pkgdesc="A TUI and CLI that help you configure NGINX, Apache or Traefik and your firewall to stop bad bots and still allow good bots (prebuilt binary)"
# Both architectures the release workflow builds a static musl binary for.
# Arch's $CARCH spells them the way the Rust target triples do, which is what
# lets one package() serve both.
arch=('x86_64' 'aarch64')
url="https://github.com/ivankovic/stop-bots"
license=('AGPL-3.0-only')
# None. The published binary is statically linked against musl, which is
# what lets one build serve every distribution; there is no libc to depend
# on. See .github/workflows/release.yml for why that target was chosen.
depends=()
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
optdepends=('nginx: to apply the generated site blocking rules'
            'apache: to apply the generated site blocking rules, instead of nginx'
            'traefik: to apply the generated blocking routers, instead of nginx'
            'nftables: to apply the generated firewall script'
            'iptables: alternative firewall backend')
_release="$url/releases/download/v$pkgver/$_pkgname-$pkgver"
source_x86_64=("$_pkgname-$pkgver-x86_64.tar.gz::$_release-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$_pkgname-$pkgver-aarch64.tar.gz::$_release-aarch64-unknown-linux-musl.tar.gz")
# Written by packaging/bump.py from the .sha256 file the release workflow
# publishes next to each tarball, rather than from a fresh download.
sha256sums_x86_64=('77c05e0b4a03467522e30d7241d163e7ea9ecf03390ef6c353745e7d13134123')
sha256sums_aarch64=('cd45206a2f7044bcb0558af1436796a72e6fc8f72e4c4241851964df2e747d6c')

package() {
  cd "$_pkgname-$pkgver-$CARCH-unknown-linux-musl"
  install -Dm0755 "$_pkgname" "$pkgdir/usr/bin/$_pkgname"
  install -Dm0644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
  # The tarball carries the man pages and completions from the release
  # after 0.1.1 on; 0.1.1's has the binary, README and LICENSE only. Drop
  # this test once the package is past 0.1.x.
  if [[ ! -d man ]]; then
    return 0
  fi
  # The man pages and completions the .deb ships, from the binary's own
  # clap definition. Arch's zsh and bash-completion look in these paths;
  # makepkg compresses the man pages itself.
  install -Dm0644 -t "$pkgdir/usr/share/man/man1/" man/*.1
  install -Dm0644 completions/stop-bots.bash "$pkgdir/usr/share/bash-completion/completions/stop-bots"
  install -Dm0644 completions/_stop-bots "$pkgdir/usr/share/zsh/site-functions/_stop-bots"
  install -Dm0644 completions/stop-bots.fish "$pkgdir/usr/share/fish/vendor_completions.d/stop-bots.fish"
}
